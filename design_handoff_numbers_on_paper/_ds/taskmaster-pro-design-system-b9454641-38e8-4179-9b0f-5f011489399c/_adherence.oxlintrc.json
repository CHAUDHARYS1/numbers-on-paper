{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/core/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Plus Jakarta Sans|IBM Plex Mono|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: Plus Jakarta Sans, IBM Plex Mono, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|userId|color|size|shape|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, userId, color, size, shape."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<Avatar> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:green|red|amber|accent|gray)$/]",
        "message": "<Badge> tone must be one of 'green' | 'red' | 'amber' | 'accent' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Column'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|count|children|key|ref|className|style|children)$/]",
        "message": "<Column> doesn't accept that prop. Declared props: label, color, count, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|textarea|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, error, textarea."
      },
      {
        "selector": "JSXOpeningElement[name.name='LabelChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|children|key|ref|className|style|children)$/]",
        "message": "<LabelChip> doesn't accept that prop. Declared props: color, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|open|onClose|footer|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: title, open, onClose, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|showLabel|key|ref|className|style|children)$/]",
        "message": "<PriorityTag> doesn't accept that prop. Declared props: level, showLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriorityTag'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:low|medium|high|urgent)$/]",
        "message": "<PriorityTag> level must be one of 'low' | 'medium' | 'high' | 'urgent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|color|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|icon|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCardTask'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|description|status|due|dueState|priority|assignee|labels|checklist|comments|key|ref|className|style|children)$/]",
        "message": "<TaskCardTask> doesn't accept that prop. Declared props: text, description, status, due, dueState, priority, assignee, labels, checklist, comments."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCardTask'] > JSXAttribute[name.name='dueState'] > Literal[value!=/^(?:overdue|due-soon)$/]",
        "message": "<TaskCardTask> dueState must be one of 'overdue' | 'due-soon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskCardTask'] > JSXAttribute[name.name='priority'] > Literal[value!=/^(?:low|medium|high|urgent)$/]",
        "message": "<TaskCardTask> priority must be one of 'low' | 'medium' | 'high' | 'urgent'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
